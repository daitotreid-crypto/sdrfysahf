# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID чата администратора для уведомлений о новых заявках
ADMIN_CHAT_ID=your_admin_chat_id_here

# URL базы данных (для PostgreSQL на Render/Supabase)
# Пример: DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=your_database_url_here
